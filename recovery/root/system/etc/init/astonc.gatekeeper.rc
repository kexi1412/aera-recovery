# SPDX-License-Identifier: Apache-2.0
# Target service name/class/identity/disabled trigger; see gatekeeper-inputs.json.
# Recovery diagnostic domain; final narrow HAL policy still requires AVC tests.
#
# REVERTED 2026-10: this original shape is CORRECT and must not be "fixed".
#
# A previous revision added `class hal` and dropped `disabled`, on the theory
# that the service could never start because the property trigger could not
# fire in recovery. That premise was falsified on hardware: the property IS
# present in the ramdisk prop.default, the trigger fires, and the service is
# up and registered under the stock shape.
#
#   $ getprop init.svc.gatekeeper-1-0
#   running
#   $ lshal | grep -i gatekeeper
#   DM Y android.hardware.gatekeeper@1.0::IGatekeeper/default @1.0::IGatekeeper  ...  938
#
# Gatekeeper was never the decrypt blocker. The real blocker was keystore2
# dying on a missing VINTF declaration; see scripts/fix-recovery-vintf.py.
# Restored verbatim to avoid regressing a working service.
service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti
    class early_hal
    user system
    group system
    disabled
    seclabel u:r:recovery:s0

on property:vendor.gatekeeper.is_security_level_spu=0
    enable gatekeeper-1-0
    # TWRP starts class hal, not early_hal. Explicit start also covers enable
    # before that class is running, without changing the target identity.
    start gatekeeper-1-0
